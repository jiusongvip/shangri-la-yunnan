          {mustSeeSpots.map((spot, i) => (
            <details class={`group rounded-2xl border border-slate-200 bg-white transition-all [&[open]]:border-emerald-200 [&[open]]:shadow-lg [&[open]]:shadow-slate-200/50 ${i >= 4 ? '' : ''}`}>
              <summary class="flex cursor-pointer list-none items-start gap-3 p-5 text-left">
                <img src={`/images/${spot.image}`} alt={spot.alt || `${spot.name} Shangri-La Yunnan`} class="w-16 h-16 rounded-lg flex-shrink-0 object-cover" width="64" height="64" loading="lazy" />
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">{spot.tag}</span>
                    <span class="flex gap-0.5" aria-label={`${spot.stars} out of 5 stars`}>
                      {Array.from({length: spot.stars}, () => (
                        <svg class="h-3 w-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                      ))}
                    </span>
                  </div>
                  <h3 class="text-base font-bold tracking-tight text-slate-900">{spot.name}</h3>
