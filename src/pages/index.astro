    <!-- Leaflet CSS + JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin></script>
    <script>
      (function(){function initMap(){if(typeof L==="undefined"){setTimeout(initMap,200);return}var el=document.getElementById("leaflet-map");if(!el||el.dataset.loaded)return;el.dataset.loaded="1";var map=L.map("leaflet-map",{center:[27.86,99.72],zoom:10,zoomControl:true,scrollWheelZoom:true});L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",{attribution:"&copy; OpenStreetMap &copy; CARTO",subdomains:"abcd",maxZoom:18}).addTo(map);var mk=L.divIcon({html:'<div style="width:26px;height:26px;background:#15803d;border:2px solid #fff;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700">\u25B2</div>',iconSize:[26,26],iconAnchor:[13,26],popupAnchor:[0,-28]});var ck=L.divIcon({html:'<div style="width:34px;height:34px;background:#f59e0b;border:3px solid #fff;border-radius:50%;box-shadow:0 3px 14px rgba(245,158,11,0.5);display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;font-weight:700">\u2605</div>',iconSize:[34,34],iconAnchor:[17,17]});var spots=[["Songzanlin Monastery",27.8640,99.7030,"Culture","songzanlin-monastery"],["Dukezong Old Town",27.8180,99.7035,"History","dukezong-old-town"],["Pudacuo National Park",27.8550,99.9820,"Nature","pudacuo-national-park"],["Napa Lake",27.8900,99.6500,"Nature","napa-lake"],["Tiger Leaping Gorge",27.1850,100.1350,"Adventure","tiger-leaping-gorge"],["Meili Snow Mountain",28.4390,98.6830,"Nature","meili-snow-mountain"],["Balagezong Canyon",28.0110,99.5310,"Nature","balagezong-canyon"],["Baishuitai Terraces",27.4840,100.0340,"Nature","baishuitai-terraces"]];spots.forEach(function(s){var m=L.marker([s[1],s[2]],{icon:mk}).addTo(map);m.bindTooltip(s[0],{direction:"top",offset:[0,-28]});m.bindPopup('<div style="font-family:system-ui,sans-serif;font-size:13px;padding:2px 0"><strong style="color:#0f172a">'+s[0]+'</strong><br><span style="display:inline-block;margin-top:3px;background:#f0fdf4;color:#15803d;padding:1px 6px;border-radius:10px;font-size:10px;font-weight:600">'+s[3]+'</span><br><a href="/attractions/'+s[4]+'" style="display:inline-block;margin-top:6px;color:#15803d;font-size:12px;font-weight:600;text-decoration:none;padding:4px 10px;border:1px solid #15803d;border-radius:6px">Read Full Guide →</a></div>',{maxWidth:220})});var cm=L.marker([27.8256,99.7017],{icon:ck,zIndexOffset:100}).addTo(map);cm.bindTooltip("Shangri-La City",{direction:"top",offset:[0,-18],permanent:true});setTimeout(function(){map.invalidateSize()},200);window.addEventListener("resize",function(){map.invalidateSize()});var obs=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)map.invalidateSize()})});obs.observe(document.getElementById("map"))}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",initMap)}else{initMap()}})();
    </script>

    <!-- ===== ITINERARIES ===== -->
    <section id="plan" class="bg-white py-20 sm:py-28">
