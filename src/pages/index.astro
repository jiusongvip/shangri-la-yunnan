  { label: "Altitude", value: "3,160 m" },
  { label: "Airport", value: "Diqing (DIG)" },
  { label: "Best Months", value: "May & Sep-Oct" },
  { label: "Avg Stay", value: "2-4 days" },
  { label: "Currency", value: "RMB (CNY)" },
