            <tbody class="divide-y divide-slate-100">
              {weatherData.map(w => (
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="px-4 py-2.5 font-medium text-slate-700">{w.month}</td>
                  <td class="px-4 py-2.5 text-slate-500">{w.tempHi}deg</td>
                  <td class="px-4 py-2.5 text-slate-500">{w.tempLo}deg</td>
                  <td class="px-4 py-2.5 text-slate-500">{w.rain}</td>
                  <td class="px-4 py-2.5">
                    <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold ${w.rating === 'Best' ? 'bg-emerald-50 text-emerald-700' : w.rating === 'Good' ? 'bg-sky-50 text-sky-700' : w.rating === 'Fair' ? 'bg-amber-50 text-amber-700' : 'bg-slate-100 text-slate-600'}`}>{w.rating}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm text-slate-400">Best months for visiting: May, June, September, October. Avoid July-August (monsoon) and December-February (extreme cold, possible road closures).</p>
