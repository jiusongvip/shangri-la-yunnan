];

const mustSeeSpots = [
  { slug: "pudacuo-national-park", name: "Pudacuo National Park", image: "pudacuo-national-park.webp", stars: 5, tag: "Nature", altitude: "3,500 m", time: "4-6 hrs", best: "May-Oct", ticket: "100 RMB", alt: "Pudacuo National Park pristine alpine lake Shudu Lake with forested shoreline crystal blue water and mountain reflections in Shangri-La Yunnan", desc: "Pristine alpine lakes, wetlands, and forests. Home to rare black-necked cranes. The Shudu Lake trail offers the most photogenic views in Shangri-La." },
  { slug: "songzanlin-monastery", name: "Songzanlin Monastery", image: "songzanlin-monastery.webp", stars: 5, tag: "Culture", altitude: "3,300 m", time: "2-3 hrs", best: "All year", ticket: "115 RMB", alt: "Songzanlin Monastery golden roof Tibetan Buddhist temple complex at 3300 meters nicknamed Little Potala Palace in Shangri-La Yunnan", desc: "The largest Tibetan Buddhist monastery in Yunnan, built in 1679. Often called the Little Potala Palace. Morning chanting ceremonies at 6:30 AM are open to visitors." },
  { slug: "dukezong-old-town", name: "Dukezong Old Town", image: "dukezong-old-town.webp", stars: 4, tag: "History", altitude: "3,300 m", time: "2-4 hrs", best: "All year", ticket: "Free", alt: "Dukezong Old Town ancient cobblestone streets with traditional Tibetan wooden buildings and giant golden prayer wheel at dusk in Shangri-La Yunnan", desc: "A 1,300-year-old Tibetan quarter rebuilt after the 2014 fire. Home to the world's largest prayer wheel (21m tall). Best explored at dusk when lanterns light up the lanes." },
  { slug: "napa-lake", name: "Napa Lake", image: "napa-lake.webp", stars: 4, tag: "Nature", altitude: "3,266 m", time: "2-4 hrs", best: "May-Oct", ticket: "60 RMB", alt: "Napa Lake seasonal alpine wetland with grazing yaks horses and snow-capped mountain backdrop under golden sunset light in Shangri-La Yunnan", desc: "A seasonal highland lake that transforms into a vast grassland in dry months. Yak and horse grazing with snow-capped mountain backdrops. Stunning at sunset." },
  { slug: "tiger-leaping-gorge", name: "Tiger Leaping Gorge", image: "tiger-leaping-gorge.webp", stars: 5, tag: "Adventure", altitude: "1,800-2,670 m", time: "1-2 days", best: "Apr-Jun, Sep-Oct", ticket: "65 RMB", alt: "Tiger Leaping Gorge dramatic deep river canyon with Jade Dragon Snow Mountain towering above Jinsha River rapids in Yunnan China", desc: "One of the deepest river gorges in the world. The high trail is a world-class 2-day trek with guesthouses along the route. Day trips to the upper gorge are also possible." },
  { slug: "meili-snow-mountain", name: "Meili Snow Mountain", image: "meili-snow-mountain.webp", stars: 5, tag: "Nature", altitude: "6,740 m", time: "1-2 days", best: "Oct-May", ticket: "Free (viewing)", alt: "Meili Snow Mountain sacred Kawagebo peak at 6740 meters glowing golden orange at sunrise viewed from Feilai Temple in Yunnan China", desc: "Sacred to Tibetan Buddhists, the Meili range includes Kawagebo, Yunnan's highest peak. The sunrise view from Feilai Temple is one of China's most iconic landscapes." },
  { slug: "balagezong-canyon", name: "Balagezong Canyon", image: "balagezong-canyon.webp", stars: 4, tag: "Nature", altitude: "2,200-4,000 m", time: "4-6 hrs", best: "May-Oct", ticket: "170 RMB", alt: "Balagezong Grand Canyon dramatic cliffs with hanging coffins and traditional Tibetan village nestled in narrow valley in Shangri-La Yunnan", desc: "A dramatic canyon with hanging coffins, Tibetan villages, and a glass skywalk. Less touristy than Tiger Leaping Gorge but equally impressive." },
  { slug: "baishuitai-terraces", name: "Baishuitai Terraces", image: "baishuitai-terraces.webp", stars: 4, tag: "Nature", altitude: "2,380 m", time: "2-3 hrs", best: "Mar-May", ticket: "30 RMB", alt: "Baishuitai natural travertine terraces with mineral-rich turquoise pools cascading down white limestone hillside in morning light in Shangri-La Yunnan", desc: "Natural travertine terraces nicknamed China's Pamukkale. Spring-fed mineral pools cascade down a hillside. Best in morning light when the pools are most reflective." },
  { slug: "haba-snow-mountain", name: "Haba Snow Mountain", image: "haba-snow-mountain.webp", stars: 4, tag: "Adventure", altitude: "5,396 m", time: "2-3 days", best: "Apr-Jun, Sep-Nov", ticket: "Guide required", alt: "Haba Snow Mountain 5396 meter peak with glaciers and mountaineers on summit ridge overlooking Jade Dragon Snow Mountain in Shangri-La Yunnan", desc: "One of China's most accessible 5,000m+ peaks. The 2-day summit climb is achievable for fit beginners with a guide. Panoramic views of Jade Dragon Snow Mountain and the Tiger Leaping Gorge from the top." },
];

const itineraries = [
  { days: "2 Days", title: "City Express", desc: "Day 1: Morning chanting at Songzanlin Monastery, lunch at a Tibetan tea house in Dukezong Old Town, cobblestone lane stroll, sunset at Napa Lake. Day 2: Full morning at Pudacuo National Park (Shudu Lake trail), lunch at the park exit noodle shop, afternoon departure. Best for weekend trips. Eat: Yak butter tea and tsampa at a Dukezong tea house." },
  { days: "3 Days", title: "Classic Shangri-La", desc: "Day 1: City highlights (Songzanlin + Dukezong + Napa Lake). Day 2: Pudacuo National Park with packed lunch. Day 3: Tiger Leaping Gorge upper section day trip - 2h drive each way, 2-3h hike on paved trail. The most popular itinerary. Eat: Naxi grilled fish at a guesthouse near the gorge on Day 3." },
  { days: "5 Days", title: "Extended Explorer", desc: "Day 1-2: Local highlights at relaxed altitude pace. Day 3: Tiger Leaping Gorge full day. Day 4: Scenic drive to Feilai Temple (4 hrs) via Baima Snow Mountain pass. Day 5: 7 AM sunrise over Meili Snow Mountain, then drive back to Shangri-La. Eat: Yak hotpot in Deqin town on Day 4 evening." },
  { days: "7+ Days", title: "Full Yunnan Circuit", desc: "Days 1-3: Classic Shangri-La. Day 4: Balagezong Canyon day trip. Day 5: Baishuitai Terraces. Day 6: Drive to Lijiang (3.5 hrs), explore UNESCO old town. Day 7: Jade Dragon Snow Mountain or Shuhe Ancient Town. Extend to Dali (+2 days) for Erhai Lake cycling. Eat: Lijiang baba (flatbread) and Dali crosstalk tofu." },
];

const weatherData = [
  { month: "Jan", tempHi: "6", tempLo: "-10", rain: "3", rating: "Fair" },
  { month: "Feb", tempHi: "8", tempLo: "-8", rain: "5", rating: "Fair" },
  { month: "Mar", tempHi: "11", tempLo: "-4", rain: "8", rating: "Good" },
