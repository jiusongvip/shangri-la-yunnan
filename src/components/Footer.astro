---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <span class="text-lg font-bold tracking-tight text-slate-900">Shangri-La Guide</span>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-slate-500">The complete single-page destination hub for planning your perfect Shangri-La trip. All information verified and updated.</p>
      </div>
      <div>
        <h5 class="text-sm font-semibold text-slate-900">Sections</h5>
        <ul class="mt-3 space-y-2" role="list">
          <li><a href="#explore" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Attractions</a></li>
          <li><a href="#plan" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Itineraries</a></li>
          <li><a href="#weather" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Weather</a></li>
          <li><a href="#altitude" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Altitude Guide</a></li>
        </ul>
      </div>
      <div>
        <h5 class="text-sm font-semibold text-slate-900">Plan</h5>
        <ul class="mt-3 space-y-2" role="list">
          <li><a href="#stay" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Where to Stay</a></li>
          <li><a href="#transport" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Transport</a></li>
          <li><a href="#costs" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Travel Costs</a></li>
          <li><a href="#pack" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Packing List</a></li>
        </ul>
      </div>
      <div>
        <h5 class="text-sm font-semibold text-slate-900">More</h5>
        <ul class="mt-3 space-y-2" role="list">
          <li><a href="#food" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Food & Culture</a></li>
          <li><a href="#tips" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Travel Tips</a></li>
          <li><a href="#faq" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">FAQ</a></li>
          <li><a href="#top" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Back to top</a></li>
          <li><a href="/about" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">About Us</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 border-t border-slate-100 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-slate-400"><a href="/privacy" class="hover:text-slate-600 transition-colors">Privacy</a> · 2024&ndash;{currentYear} Shangri-La Guide. Not affiliated with any hotel or tour company.</p>
      <p class="text-xs text-slate-400">Last updated: August 2026</p>
    </div>
  </div>
</footer>
