---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  category: "Attraction" | "Food";
  image: string;
  schema: Record<string, any>;
}

const { title, description, category, image, schema } = Astro.props;
const schemaJson = JSON.stringify(schema);
const breadcrumbName = category === "Attraction" ? "Attractions" : "Food & Culture";
const breadcrumbUrl = "https://shangri-la-yunnan.com/" + (category === "Attraction" ? "#explore" : "#food");
const breadcrumbJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://shangri-la-yunnan.com/" },
    { "@type": "ListItem", "position": 2, "name": breadcrumbName, "item": breadcrumbUrl },
    { "@type": "ListItem", "position": 3, "name": title }
  ]
});
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Shangri-La Yunnan Travel Guide</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={`https://shangri-la-yunnan.com${Astro.url.pathname}`} />
  <link rel="alternate" hreflang="x-default" href={`https://shangri-la-yunnan.com${Astro.url.pathname}`} />

  <meta property="og:title" content={`${title} | Shangri-La Yunnan`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:image" content={`https://shangri-la-yunnan.com/images/${image}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={`https://shangri-la-yunnan.com${Astro.url.pathname}`} />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" set:html={schemaJson}></script>

  <script type="application/ld+json" set:html={breadcrumbJson}></script>

  <script is:inline>
    document.documentElement.classList.add('js');
  </script>
</head>
<body class="min-h-screen bg-white text-slate-900 antialiased">
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-900 hover:text-emerald-700 transition-colors">
          <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
          Shangri-La Guide
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href="/#explore" class="px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">Attractions</a>
          <a href="/#food" class="px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">Food &amp; Culture</a>
          <a href="/#plan" class="px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">Plan</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <div class="bg-slate-50 border-b border-slate-100">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-1.5 text-xs text-slate-400">
          <a href="/" class="hover:text-emerald-600 transition-colors">Home</a>
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          <a href={category === "Attraction" ? "/#explore" : "/#food"} class="hover:text-emerald-600 transition-colors">{category === "Attraction" ? "Attractions" : "Food &amp; Culture"}</a>
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-600 font-medium truncate max-w-[200px]">{title}</span>
        </nav>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <img src={`/images/${image}`} alt={title} class="w-full aspect-[16/9] rounded-2xl object-cover shadow-sm" width="1200" height="675" />
    </div>

    <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </article>

    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pb-8">
      <div class="border-t border-slate-200 pt-6 flex items-center gap-3 flex-wrap">
        <p class="text-xs text-slate-400">By <span class="font-medium text-slate-600">Shangri-La Guide Team</span></p>
        <span class="text-slate-300">·</span>
        <p class="text-xs text-slate-400">Updated <span class="font-medium text-slate-600">August 2026</span></p>
      </div>
    </div>
  </main>

  <footer class="border-t border-slate-200 bg-white mt-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-slate-400">&copy; 2024&ndash;{new Date().getFullYear()} Shangri-La Guide. Not affiliated with any hotel or tour company.</p>
      <a href="/" class="text-sm text-emerald-600 hover:text-emerald-700 transition-colors font-medium">Back to Home</a>
    </div>
  </footer>
</body>
</html>