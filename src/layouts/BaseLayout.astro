---
import "../styles/global.css";
import "@fontsource/outfit/300.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import "@fontsource/outfit/800.css";

const { title = "Shangri-La Yunnan — Travel Guide", description = "Plan your Shangri-La Yunnan trip in one place. Top attractions, trip planner, altitude guide, hotel and budget tips.", noindex = false, preloadImage = "", preloadImageSrcset = "", preloadImageSizes = "100vw" } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) — injected after page load to keep it off the critical path -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-EJQL3P8NDE');
    window.addEventListener('load', function(){
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-EJQL3P8NDE';
      document.head.appendChild(s);
    });
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="datePublished" content="2024-01-01" />
  <meta name="dateModified" content="2026-08-05" />
  <link rel="alternate" hreflang="x-default" href={Astro.url.pathname === "/" ? "https://www.shangri-la-yunnan.com" : `https://www.shangri-la-yunnan.com${Astro.url.pathname}`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://www.shangri-la-yunnan.com/og-image.webp" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Shangri-La Guide" />
  <meta property="og:url" content={Astro.url.pathname === "/" ? "https://www.shangri-la-yunnan.com" : `https://www.shangri-la-yunnan.com${Astro.url.pathname}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://www.shangri-la-yunnan.com/og-image.webp" />
  {preloadImage && (preloadImageSrcset
    ? <link rel="preload" as="image" fetchpriority="high" href={preloadImage} imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} />
    : <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />)}
  {!noindex && <link rel="canonical" href={Astro.url.pathname === "/" ? "https://www.shangri-la-yunnan.com" : `https://www.shangri-la-yunnan.com${Astro.url.pathname}`} />}

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.shangri-la-yunnan.com"
    }]
  }
  </script>

  <!-- Organization + WebSite Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Shangri-La Guide",
    "url": "https://www.shangri-la-yunnan.com",
    "description": "Complete Shangri-La Yunnan travel guide and destination hub.",
    "logo": "https://www.shangri-la-yunnan.com/favicon.svg",
    "email": "hello@shangri-la-yunnan.com",
    "sameAs": [
      "https://www.tripadvisor.com/Tourism-g303773-Shangri_La_Yunnan-Vacations.html",
      "https://www.wikidata.org/wiki/Q1207070",
      "https://en.wikipedia.org/wiki/Shangri-La,_Yunnan"
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Shangri-La Guide",
    "url": "https://www.shangri-la-yunnan.com"
  }
  </script>

  <script is:inline>
    document.documentElement.classList.add('js');
  </script>
</head>
<body class="min-h-screen bg-[var(--color-surface)] text-[var(--color-ink)] antialiased">
  <slot />
</body>
</html>
